{
  "name": "@stech/kiosk",
  "version": "0.1.0",
  "private": true,
  "description": "S TECH dokunmatik müşteri kiosku",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --windowed",
    "test": "node --test test/*.test.cjs",
    "check": "node scripts/check.cjs",
    "test:ui": "node scripts/ui-smoke.cjs",
    "pack:win": "electron-builder --win --x64 --dir",
    "build:win": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "electron": "45.1.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "compression": "normal",
    "toolsets": { "nsis": "1.2.1" },
    "appId": "com.stech.kiosk",
    "productName": "kiosk",
    "executableName": "kiosk",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**",
      "ui/**",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "kiosk.exe"
    }
  }
}
