ENVIRONMENT=development
PORT=3001
CAFE_ADAPTER=mock
PAYMENT_PROVIDER=mock
# Development only: separate test credit for PanCafe users; never credits PanCafe.
PANCAFE_PAYMENT_SIMULATION=false
# With explicit bridge permission, mock checkout credits the actual PanCafe account.
PANCAFE_BALANCE_CREDIT=false
# Optional: mirror PanCafe members and balances into a private Cloud Firestore database.
FIREBASE_SYNC_ENABLED=false
FIREBASE_BALANCE_WRITE_ENABLED=false
# Campaigns automatically sync when FIREBASE_SYNC_ENABLED=true.
# Enable only campaign distribution on an admin API with a separate local bridge:
FIREBASE_CAMPAIGN_SYNC_ENABLED=false
# FIREBASE_CAMPAIGN_INSTALLATION_ID=stech-b
# FIREBASE_PROJECT_ID=wallet-stech
# GOOGLE_APPLICATION_CREDENTIALS=C:/private/wallet-stech-credentials.json
DEMO_PASSWORD=StechDemo2026!
# Optional: NFC kiosk login (PanCafe LASTNAME stores the reader UID).
# Never share the device key with mobile/web. Card map file is only for mock mode.
# KIOSK_DEVICE_KEY=<at-least-40-random-characters>
# KIOSK_CARD_MAP_FILE=/absolute/path/kiosk-cards.json
DATA_DIR=.data/stech
WEB_ORIGIN=http://localhost:8081
# Required for private profile fields/history. Generate 32 random bytes as 64 hex characters; keep outside Git.
# PROFILE_ENCRYPTION_KEY=<64-hex-character-secret>
# Ödeal D2D requires a public HTTPS callback and matching Ödeal configuration.
# Leave ODEAL_POS_ENV unset to keep POS payments disabled. Use stage first.
# ODEAL_POS_ENV=stage
# ODEAL_MERCHANT_KEY=
# ODEAL_SECRET_KEY=
# ODEAL_REQUEST_KEY=
# ODEAL_DEVICE_CODE=KIOSK1
# ODEAL_WEBHOOK_BASE_URL=https://your-domain.example/api/v1/webhooks/odeal
# ODEAL_BASKET_TYPE=SIMPLE
# ODEAL_CITY=
# ODEAL_TOWN=
# ODEAL_VAT_RATE=
# Set DATABASE_URL to use a standalone PostgreSQL instance instead of local PGlite.
# DATABASE_URL=postgresql://stech:password@localhost:5432/stech
